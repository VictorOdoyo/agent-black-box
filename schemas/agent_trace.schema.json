{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-black-box.dev/schemas/agent_trace.schema.json",
  "title": "Agent Black Box Trace",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "run_id",
    "app",
    "started_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "abb.trace.v1"
    },
    "trace_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "app": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "timestamp",
          "actor",
          "summary",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fingerprint": {
            "type": "string"
          }
        }
      }
    }
  }
}
